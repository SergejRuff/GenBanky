type = sub("^\\s{5}(\\w+).*", "\\1", line),
location = sub("^\\s{5}\\w+\\s+(.*)", "\\1", line),
qualifiers = list()
)
} else if(grepl("^\\s{21}/", line)) {
qual <- sub("^\\s+/", "", line)
key <- sub("=.*", "", qual)
value <- sub('.*?"(.*?)"', "\\1", qual)
current_feat$qualifiers[[key]] <- value
}
}
if(!is.null(current_feat)) {
features[[current_feat$type]] <- c(features[[current_feat$type]], current_feat)
}
lapply(features, function(feat_list) {
lapply(feat_list, function(f) {
new("GBFeature",
type = f$type,
location = f$location,
qualifiers = f$qualifiers)
})
})
}
parse_origin <- function(lines) {
origin_lines <- get_section_lines(lines, "ORIGIN")[-1]
paste0(gsub("[^a-zA-Z]", "", unlist(strsplit(origin_lines, "\\s+"))),
collapse = "")
}
get_section_lines <- function(lines, section) {
start <- grep(paste0("^\\s{0,2}", section), lines)
if (!length(start)) return(character(0))
next_section <- grep("^\\s{0,2}[A-Z]", lines[-(1:start)])[1]
end <- if (!is.na(next_section)) start + next_section - 2 else length(lines)
lines[start:end]
}
extract_subfield <- function(lines, field) {
field_lines <- grep(paste0("^\\s+", field), lines, value = TRUE)
paste(sub(paste0("^\\s+", field, "\\s+"), "", field_lines), collapse = "\n")
}
